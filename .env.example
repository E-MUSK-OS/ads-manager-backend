# App
ENVIRONMENT=development
ADS_PROVIDER=amazon
LLM_PROVIDER=none
FRONTEND_URL=http://localhost:3000
RECOMMENDATION_ENGINE=rules
SUPPORTED_MARKETPLACES=IN
CONTACT_RETENTION_DAYS=365

# Database
DATABASE_URL=postgresql+asyncpg://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/YOUR_NEON_DB?ssl=require
# REDIS_URL=redis://your-upstash-endpoint:6379/0  # Deferred until needed

# Auth
# Must be a long random value, never the literal word "changeme", especially in production
JWT_SECRET_KEY=your_random_jwt_secret_key_at_least_32_characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_OAUTH_CLIENT_ID=

# Amazon Ads API / Login with Amazon (LWA)
AMAZON_ADS_REGION=eu
AMAZON_LWA_SCOPE=advertising::campaign_management
TOKEN_ENCRYPTION_KEY=your_fernet_encryption_key_here
AMAZON_LWA_CLIENT_ID=amzn1.application-oa2-client.your_client_id
AMAZON_LWA_CLIENT_SECRET=your_lwa_client_secret
AMAZON_LWA_REDIRECT_URI=http://localhost:3000/connect-amazon/callback
AMAZON_ADS_API_BASE_URL=

# AI
ANTHROPIC_API_KEY=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
